{
  "name": "omni-ai-chat",
  "version": "1.2.0",
  "description": "Multi-platform desktop client integrating multiple AI chats with global broadcast.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder --win --mac"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.omniaichat.app",
    "productName": "OmniAIChat",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "runAfterFinish": false
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "Sachin Kumar (M5Q7N9D29M)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OmniAI Chat needs microphone access so voice input works on AI chat sites that support it.",
        "NSCameraUsageDescription": "OmniAI Chat needs camera access so video/image features work on AI chat sites that support it."
      }
    },
    "afterSign": "build/notarize.js",
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "renderer.js",
      "injection-script.js",
      "sites.json",
      "assets/**/*",
      "package.json"
    ]
  }
}
